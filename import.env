# Đây là file biến môi trường mẫu. Bạn có thể sử dụng nội dung này để khai báo trên Vercel hoặc đổi tên file này thành .env để dùng ở máy tính cá nhân.
DATABASE_URL=postgresql://postgres.[Mã_Project]:[Mật_khẩu]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Cổng chạy server (mặc định 3000)
PORT=3000

# Khóa bảo mật cho phiên đăng nhập (session) - bạn nên thay đổi chuỗi này thành một chuỗi ngẫu nhiên
SESSION_SECRET=sogielia-super-secret-key-season7
